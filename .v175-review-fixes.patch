+      providerEventId: offer.providerEventId,
+    }, now));
+}
+
+function existingProviderObservation(existing, now) {
+  if (!providerEventId(existing) && !text(existing?.sourceProvider)) return null;
+  return observationFromCandidate(existing, now);
+}
