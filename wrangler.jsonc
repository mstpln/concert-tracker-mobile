{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "concert-tracker-api",
  "main": "./workerV104.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "preview_urls": true,

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "concert-tracker-data"
    }
  ]
}
